  {
    "id": "fn-temp-wb",
    "type": "function",
    "z": "tab-flow-wb",
    "name": "Temperatura",
    "func": "let d = msg.payload;\nmsg.topic = d.estacaoId || \"desk-01\";\nmsg.payload = d.temperatura;\nreturn msg;",
