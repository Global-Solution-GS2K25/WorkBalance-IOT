  {
    "id": "fn-conforto-wb",
    "type": "function",
    "z": "tab-flow-wb",
    "name": "Índice de conforto",
    "func": "let d = msg.payload;\nlet motivos = [];\n\nif (d.temperatura > 28) motivos.push(\"Calor excessivo\");\nif (d.ruido > 70) motivos.push(\"Ruído alto\");\nif (d.luminosidade < 200) motivos.push(\"Pouca luz\");\n\nlet indice = motivos.length === 0 ? \"Confortável\" : \"Desconfortável\";\n\nmsg.payload = `Estação ${d.estacaoId || \"desk-01\"}: ${indice}` + (motivos.length ? ` (Motivos: ${motivos.join(\", \")})` : \"\");\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 605,
    "y": 220,
